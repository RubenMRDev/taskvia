{
  "name": "taskvia",
  "productName": "Taskvia",
  "version": "1.2.0",
  "description": "Tus proyectos en local: tableros kanban y documentación en markdown, con un servidor MCP para trabajar con tu asistente de IA.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "mcp": "node mcp.js",
    "test": "node test.js",
    "test:ui": "node test-ui.js",
    "icono": "electron tools/icono.mjs",
    "dist": "electron-builder --win",
    "release": "electron-builder --win --publish always"
  },
  "keywords": [
    "kanban",
    "markdown",
    "mcp",
    "ai",
    "electron",
    "local-first"
  ],
  "author": "Rubén",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "electron-updater": "^6.8.11",
    "lucide-static": "^1.70.0",
    "marked": "^18.1.3",
    "turndown": "^7.2.5",
    "turndown-plugin-gfm": "^1.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "playwright-core": "^1.65.0"
  },
  "build": {
    "appId": "com.taskvia.app",
    "productName": "Taskvia",
    "asar": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!test*.js",
      "!docs",
      "!tools",
      "!data",
      "!*.md",
      "!.impeccable",
      "!dist"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "Taskvia",
      "artifactName": "Taskvia-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "RubenMRDev",
        "repo": "taskvia",
        "releaseType": "release"
      }
    ]
  }
}
